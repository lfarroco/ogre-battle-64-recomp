@@ -501,6 +501,30 @@ void N64Recomp::CGenerator::emit_cop0_status_write(int reg) const {
     fmt::print(output_file, "cop0_status_write(ctx, {});", gpr_to_string(reg));
 }
 
+void N64Recomp::CGenerator::emit_cop0_read(int reg, int cop0_reg) const {
+    fmt::print(output_file, "{} = cop0_read(ctx, {});\n", gpr_to_string(reg), cop0_reg);
+}
+
+void N64Recomp::CGenerator::emit_cop0_write(int reg, int cop0_reg) const {
+    fmt::print(output_file, "cop0_write(ctx, {}, {});\n", cop0_reg, gpr_to_string(reg));
+}
+
+void N64Recomp::CGenerator::emit_tlb_instruction(int opcode) const {
+    fmt::print(output_file, "tlb_instruction(ctx, {});\n", opcode);
+}
+
+void N64Recomp::CGenerator::emit_eret() const {
+    fmt::print(output_file, "eret(ctx);\n");
+}
+
+void N64Recomp::CGenerator::emit_cache_instruction(int op, int base_reg, int offset) const {
+    if (base_reg == 0) {
+        fmt::print(output_file, "cache_instruction(ctx, {}, 0x{:X});\n", op, offset);
+    } else {
+        fmt::print(output_file, "cache_instruction(ctx, {}, ctx->r{} + 0x{:X});\n", op, base_reg, offset);
+    }
+}
+
 void N64Recomp::CGenerator::emit_cop1_cs_read(int reg) const {
     fmt::print(output_file, "{} = get_cop1_cs();\n", gpr_to_string(reg));
 }
