+static void set_thread_blocked(RDRAM_ARG ThreadBlockKind kind, uint32_t mq_) {
+    PTR(OSThread) self = ultramodern::this_thread();
+    if (self == 0) {
+        return;
+    }
+    int tid = TO_PTR(OSThread, self)->id;
+    if (tid < 0 || tid >= (int)thread_block_kind.size()) {
+        return;
+    }
+    thread_block_kind[tid].store((uint32_t)kind, std::memory_order_relaxed);
+    thread_block_queue[tid].store(mq_, std::memory_order_relaxed);
+}
+
+static void clear_thread_blocked(RDRAM_ARG1) {
+    PTR(OSThread) self = ultramodern::this_thread();
+    if (self == 0) {
+        return;
+    }
+    int tid = TO_PTR(OSThread, self)->id;
+    if (tid < 0 || tid >= (int)thread_block_kind.size()) {
+        return;
+    }
+    thread_block_kind[tid].store((uint32_t)ThreadBlockKind::None, std::memory_order_relaxed);
