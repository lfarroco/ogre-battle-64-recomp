+    // DMA but are not yet all recompiled/registered (Phase 4). Log and return a
+    // no-op stub so the boot can proceed instead of hard-failing.
+    uint32_t a = (uint32_t)addr;
+    if ((a >= 0x8016A000 && a < 0x80400000) || (a >= 0x84000000 && a < 0x84200000)) {
+        last_streamed_stub_addr.store(a);
+        // Temporary diagnostic: dump the calling thread's recompiled call chain
+        // so a stub call can be attributed to the exact game function, plus the
+        // first words at the address — real overlay code there means the game
+        // copied a bank in that was not registered, zeros/garbage means the
+        // pointer itself is stale.
+        uint8_t* rdram = ultramodern::get_rdram_base();
+        if (rdram != nullptr) {
+            fprintf(stderr, "[overlays]   @0x%08X: %08X %08X %08X %08X\n", a,
+                    (uint32_t)MEM_W(0x0, (gpr)(int32_t)a), (uint32_t)MEM_W(0x4, (gpr)(int32_t)a),
+                    (uint32_t)MEM_W(0x8, (gpr)(int32_t)a), (uint32_t)MEM_W(0xC, (gpr)(int32_t)a));
+        }
+        dump_caller_chain("streamed-stub");
+        return streamed_stub_generic;
+    }
+
+    fprintf(stderr, "Failed to find function at 0x%08X\n", addr);
+    dump_caller_chain("null-lookup");
+#if !defined(__EMSCRIPTEN__)
+    // Temporary: dump the host call stack to identify the caller.
+    void* bt[32];
+    int n = backtrace(bt, 32);
+    char** syms = backtrace_symbols(bt, n);
