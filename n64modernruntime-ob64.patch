+// ---------------------------------------------------------------------------
+// Streamed-overlay bank management (Phase 4). See librecomp/overlays.hpp.
+// ---------------------------------------------------------------------------
+
+// The base sections (entry + main) sit at their linear-mapped addresses and are
+// never swapped. Every code section above them is a streamed overlay that the
+// game may replace with a different bank at the same RAM address.
+static constexpr int32_t kFirstStreamedRamAddr = (int32_t)0x800E0000;
+
+static bool is_section_loaded(size_t section_table_index) {
+    for (const auto& section : loaded_sections) {
+        if (section.section_table_index == section_table_index) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void recomp::overlays::unload_overlapping_overlays(int32_t ram_addr, uint32_t size) {
+    const int64_t lo = (int64_t)ram_addr;
+    const int64_t hi = (int64_t)ram_addr + (int64_t)size;
+
+    for (auto it = loaded_sections.begin(); it != loaded_sections.end();) {
+        const SectionTableEntry& section = sections_info.code_sections[it->section_table_index];
+        const int64_t section_lo = (int64_t)it->loaded_ram_addr;
+        const int64_t section_hi = section_lo + (int64_t)section.size;
+
+        if (section_lo < hi && lo < section_hi) {
+            // Only the entries the new bank actually covers are gone. A bank
+            // record is usually narrower than the overlay it replaces (record 2
+            // is 0x72C0 bytes of overlay C's 0x229C0), and the RAM above it is
+            // not overwritten, so that overlay's code there still runs. Dropping
+            // its function-map entries too made every call into that tail hit the
+            // generic stub — that is what removed the intro's smoke puffs
+            // (`func_8019E588`) and the "Ogre Battle" logo's 3D characters.
+            const int64_t keep_below = (lo > section_lo) ? lo : section_lo;
+            const int64_t keep_above = (hi < section_hi) ? hi : section_hi;
+            for (size_t func_index = 0; func_index < section.num_funcs; func_index++) {
+                const int64_t func_addr =
+                    (int64_t)section.funcs[func_index].offset + (int64_t)it->loaded_ram_addr;
+                if (func_addr >= keep_below && func_addr < keep_above) {
+                    func_map.erase((int32_t)func_addr);
+                }
+            }
+            section_addresses[section.index] = section.ram_addr;
+            it = loaded_sections.erase(it);
+        } else {
+            ++it;
+        }
+    }
+
+    for (auto it = loaded_function_banks.begin(); it != loaded_function_banks.end();) {
+        const int64_t bank_lo = (int64_t)it->ram_addr;
+        const int64_t bank_hi = bank_lo + (int64_t)it->size;
+
+        if (bank_lo < hi && lo < bank_hi) {
+            // Same rule as above: a bank that is only partly covered keeps the
+            // entries in the RAM this load does not touch.
+            const int64_t keep_below = (lo > bank_lo) ? lo : bank_lo;
+            const int64_t keep_above = (hi < bank_hi) ? hi : bank_hi;
+            for (size_t i = 0; i < it->count; i++) {
+                const int64_t func_addr = (int64_t)it->funcs[i].ram_addr;
+                if (func_addr >= keep_below && func_addr < keep_above) {
+                    func_map.erase((int32_t)func_addr);
+                }
+            }
+            it = loaded_function_banks.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+void recomp::overlays::load_function_bank(uint32_t rom_start, int32_t ram_addr, uint32_t size, const BankFunctionEntry* funcs, size_t count) {
+    unload_overlapping_overlays(ram_addr, size);
+    for (size_t i = 0; i < count; i++) {
+        func_map[funcs[i].ram_addr] = funcs[i].func;
+    }
+    loaded_function_banks.push_back({ rom_start, ram_addr, size, funcs, count });
+}
+
+bool recomp::overlays::is_function_bank_loaded(uint32_t rom_start) {
+    for (const auto& bank : loaded_function_banks) {
+        if (bank.rom_start == rom_start) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void recomp::overlays::set_streamed_dma_hook(void (*hook)(uint32_t, uint32_t, uint32_t)) {
+    streamed_dma_hook = hook;
+}
+
+// ---------------------------------------------------------------------------
+// Overlay-state checkpoints (Phase 4 tooling).
+//
+// A save state is the whole 8 MiB RDRAM *plus* the state that does not live in
+// RDRAM: `func_map` (which recompiled function body runs at each RAM address —
+// a bank record the game DMA'd) and the records describing what is loaded where
+// (`loaded_sections`, `loaded_function_banks`). Restoring RDRAM alone would
+// rewind the game's data while leaving the function map on the *later* bank, so
+// a restored scene would run the wrong module's bodies at those addresses —
+// exactly the session-45/55 mis-binding class (AGENTS §4).
+//
+// `func_map` is not serialised: it is exactly the unions of the two record
+// lists, so it is rebuilt from them on restore. `section_addresses` is derived
+// from `loaded_sections` too (`load_overlay` writes it). A blob is
+// self-describing enough to reject a mismatch (magic, version, byte count and
+// an FNV-1a over the blob's own bytes), because a checkpoint is only valid for
+// the binary that wrote it.
+//
+// The app drives this; see `save`/`load` in app/src/sdl_platform.cpp and
+// docs/guides/app-build.md -> "Checkpoints".
+// ---------------------------------------------------------------------------
+namespace {
+constexpr uint32_t kOverlayStateMagic = 0x4F565331u;  // "OVS1"
+constexpr uint32_t kOverlayStateVersion = 1u;
+
+struct OverlayStateHeader {
+    uint32_t magic;
+    uint32_t version;
+    uint64_t total_size;
+    uint64_t num_sections;
+    uint64_t num_banks;
+    uint64_t checksum;  // FNV-1a over the header (with this field zero) + body
+};
+
+uint64_t fnv1a_bytes(uint64_t hash, const void* data, size_t size) {
+    const uint8_t* p = static_cast<const uint8_t*>(data);
+    for (size_t i = 0; i < size; i++) {
+        hash ^= (uint64_t)p[i];
+        hash *= 1099511628211ull;
+    }
+    return hash;
+}
+
+constexpr uint64_t kFnv1aOffsetBasis = 14695981039346656037ull;
+
+struct SerializedSection {
+    int32_t loaded_ram_addr;
+    uint64_t section_table_index;
+};
+
+struct SerializedBank {
+    uint32_t rom_start;
+    int32_t ram_addr;
+    uint32_t size;
+    uint64_t count;
+};
+}  // namespace
+
+std::vector<uint8_t> recomp::overlays::get_overlay_state_blob() {
+    const size_t body_size = sizeof(OverlayStateHeader) +
+                             loaded_sections.size() * sizeof(SerializedSection) +
+                             loaded_function_banks.size() * sizeof(SerializedBank);
+    std::vector<uint8_t> blob(body_size, 0);
+    OverlayStateHeader header{};
+    header.magic = kOverlayStateMagic;
+    header.version = kOverlayStateVersion;
+    header.total_size = (uint64_t)body_size;
+    header.num_sections = (uint64_t)loaded_sections.size();
+    header.num_banks = (uint64_t)loaded_function_banks.size();
+    header.checksum = 0;
+    std::memcpy(blob.data(), &header, sizeof(header));
+
+    size_t offset = sizeof(header);
+    for (const LoadedSection& section : loaded_sections) {
+        SerializedSection out{};
+        out.loaded_ram_addr = section.loaded_ram_addr;
+        out.section_table_index = (uint64_t)section.section_table_index;
+        std::memcpy(blob.data() + offset, &out, sizeof(out));
+        offset += sizeof(out);
+    }
+    for (const LoadedFunctionBank& bank : loaded_function_banks) {
+        SerializedBank out{};
+        out.rom_start = bank.rom_start;
+        out.ram_addr = bank.ram_addr;
+        out.size = bank.size;
+        out.count = (uint64_t)bank.count;
+        std::memcpy(blob.data() + offset, &out, sizeof(out));
+        offset += sizeof(out);
+    }
+
+    // Checksum over the header with `checksum == 0` plus the whole body, so the
+    // app's copy is validated by the same value it stored.
+    header.checksum = fnv1a_bytes(kFnv1aOffsetBasis, blob.data(), blob.size());
+    std::memcpy(blob.data(), &header, sizeof(header));
+    return blob;
+}
+
+bool recomp::overlays::restore_overlay_state_blob(std::span<const uint8_t> blob) {
+    if (blob.size() < sizeof(OverlayStateHeader)) {
+        return false;
+    }
+    OverlayStateHeader header{};
+    std::memcpy(&header, blob.data(), sizeof(header));
+    if (header.magic != kOverlayStateMagic || header.version != kOverlayStateVersion) {
+        return false;
+    }
+    if (header.total_size != (uint64_t)blob.size()) {
+        return false;
+    }
+    const size_t expected = sizeof(OverlayStateHeader) +
+                            (size_t)header.num_sections * sizeof(SerializedSection) +
+                            (size_t)header.num_banks * sizeof(SerializedBank);
+    if (expected != blob.size()) {
+        return false;
+    }
+
+    // Rebuild the function map from the record lists rather than serialising it:
+    // `load_overlay` / the bank entries are what populate it, and replaying them
+    // in the stored order reproduces the same final map (later writes win, which
+    // is how a bank overwrites another bank's entries).
+    func_map.clear();
+    loaded_sections.clear();
+
+    // Function pointers are process-local (ASLR), so a bank's blob carries only
+    // its extent; its entries come from the `loaded_function_banks` record of
+    // *this* process. Keep that list aside while the bank list is rebuilt, then
+    // re-register the entries each record had. A checkpoint is therefore only
+    // valid within the run that wrote it, which is what the app documents.
+    std::vector<LoadedFunctionBank> previous_banks;
+    previous_banks.swap(loaded_function_banks);
+
+    size_t offset = sizeof(header);
+    for (uint64_t i = 0; i < header.num_sections; i++) {
+        SerializedSection in{};
+        std::memcpy(&in, blob.data() + offset, sizeof(in));
+        offset += sizeof(in);
+        const size_t index = (size_t)in.section_table_index;
+        if (index >= sections_info.num_code_sections) {
+            continue;
+        }
+        load_overlay(index, in.loaded_ram_addr);
+    }
+
+    for (uint64_t i = 0; i < header.num_banks; i++) {
+        SerializedBank in{};
+        std::memcpy(&in, blob.data() + offset, sizeof(in));
+        offset += sizeof(in);
+        const LoadedFunctionBank* source = nullptr;
+        for (const LoadedFunctionBank& bank : previous_banks) {
+            if (bank.rom_start == in.rom_start && bank.ram_addr == in.ram_addr &&
+                (uint64_t)bank.count == in.count) {
+                source = &bank;
+                break;
+            }
+        }
+        if (source == nullptr) {
+            continue;
+        }
+        for (size_t f = 0; f < source->count; f++) {
+            func_map[source->funcs[f].ram_addr] = source->funcs[f].func;
+        }
+        loaded_function_banks.push_back(*source);
+    }
+    return true;
+}
+
+void recomp::overlays::notify_rom_read(uint32_t rom_offset, uint32_t ram_addr, uint32_t size) {
+    if (sections_info.code_sections != nullptr) {
+        for (size_t i = 0; i < sections_info.num_code_sections; i++) {
+            const SectionTableEntry& section = sections_info.code_sections[i];
