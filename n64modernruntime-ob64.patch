+    // Fixed addresses in the rdram buffer well above anything OB64 uses (game data
+    // ends ~0x8016C900; manual-patch-symbol range starts at 0x8F000000).
+    constexpr uint32_t drainer_entry_vram = 0x8E000000;
+    constexpr uint32_t os_thread_vram = 0x8E001000;
+    constexpr uint32_t stack_top_vram = 0x8E010000;
+
+    recomp::overlays::add_loaded_function(drainer_entry_vram, external_message_drainer_entry);
+    // Priority 5: in this runtime, HIGHER numbers are scheduled first, so the
+    // drainer must be BELOW the threads it wakes (game thread pri 10, audio 120,
+    // RSP 100-111, DMA 50) so it yields to them once they're scheduled, but above
+    // the busy-spinning main thread (pri 0) which never sits in the running queue.
+    osCreateThread(rdram, os_thread_vram, 200, drainer_entry_vram, 0, stack_top_vram, 5);
+    osStartThread(rdram, os_thread_vram);
+    printf("[drainer] spawned external-message drainer thread (id 200)\n");
+}
