+        if (devAddr == 0 || size == 0) {
+            OGRE_TRACE("[pi] inline DMA with zero dev/size; completing anyway\n");
+        } else {
+            uint32_t dev_off = (devAddr >= recomp::rom_base) ? (devAddr - recomp::rom_base) : devAddr;
+            recomp::do_rom_read(rdram, (gpr)(int32_t)dramAddr, recomp::rom_base + dev_off, size);
+        }
+
+        // Complete the request synchronously: wake the caller's completion queue.
+        if (mq != 0) {
+            ultramodern::enqueue_external_message_src(mq, (OSMesg)(int32_t)mesg_addr, false,
+                                                      ultramodern::EventMessageSource::Pi);
+        }
+    });
+
+    printf("[pi] PI manager initialized (queue=0x%08X)\n", PI_REQUEST_QUEUE);
+}
+
+
+// func_8008BC40 (OB64 game code): the game's DMA-request starter. On real
+// hardware it queues the OSIoMesg to the PI thread. The runtime's
+// osCreatePiManager is an empty stub, so the game's PI-manager globals
+// (D_800AA400/D_800AA408) are never initialized; the game's own DMA path then
+// bails out and the blocking callers (func_80089F80 / func_8008A0F0) wait
+// forever on their completion queue (the boot's first streamed-code load
+// deadlocks here). Reimplemented as a synchronous ROM read: copy the requested
+// bytes straight from the ROM and complete the OSIoMesg immediately.
+extern "C" void func_8008BC40_recomp(uint8_t* rdram, recomp_context* ctx) {
+    // a0 = PI handle (unused), a1 = OSIoMesg*, a2 = dir (0 = read, 1 = write).
+    uint32_t mesg = (uint32_t)ctx->r5;
+    if (mesg == 0) {
+        ctx->r2 = (gpr)-1;
+        return;
+    }
+
+    // Game's OSIoMesg layout: type@0 (half), pri@2 (byte), mq@4, dramAddr@8,
+    // devAddr@0xC, size@0x10 (all words).
+    uint32_t mq       = MEM_W(0x04, (gpr)(int32_t)mesg);
+    uint32_t dramAddr = MEM_W(0x08, (gpr)(int32_t)mesg);
+    uint32_t devAddr  = MEM_W(0x0C, (gpr)(int32_t)mesg);
+    uint32_t size     = MEM_W(0x10, (gpr)(int32_t)mesg);
+    uint32_t dir      = (uint32_t)ctx->r6;
+
+    printf("[pi] func_8008BC40 dir=%u dram=0x%08X dev=0x%08X size=0x%X mq=0x%08X\n",
+           dir, dramAddr, devAddr, size, mq);
+    fflush(stdout);
+
+    if (dir == 0) {
+        // devAddr is a raw ROM offset (or possibly a full physical address).
+        // Use do_rom_read so the big-endian ROM bytes are byte-swapped into
+        // host-order RDRAM words (MEM_B), matching the recompiled MEM_W access.
+        uint32_t dev_off = (devAddr >= recomp::rom_base) ? (devAddr - recomp::rom_base) : devAddr;
+        recomp::do_rom_read(rdram, (gpr)(int32_t)dramAddr, recomp::rom_base + dev_off, size);
+    } else {
+        fprintf(stderr, "[pi] func_8008BC40: unsupported DMA write dir=%u (dev=0x%08X size=0x%X)\n", dir, devAddr, size);
+    }
+
+    // Complete the request synchronously so the caller's osRecvMesg returns.
+    osSendMesg(rdram, (int32_t)mq, (OSMesg)(int32_t)mesg, OS_MESG_NOBLOCK);
+
+    ctx->r2 = 0;
 }
 
