+    //   D_800AA400 = __osPiDevMgr (non-zero once the manager exists)
+    //   D_800AA408 = &__osPiDevMgr.queue (the DMA-request queue)
+    // With both zero, the recompiled func_8008BC40 bails out (-1) and DMA
+    // callers (func_80089F80 etc.) block forever on their completion queue
+    // (the boot's audio-path DMA deadlocks here). Initialize them and route
+    // the request queue through the runtime's synchronous DMA handler.
+    init_pi_manager(rdram);
