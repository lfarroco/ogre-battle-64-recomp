+// Temporary diagnostic: dump the calling N64 thread's recompiled call chain.
+static void dump_caller_chain(const char* label) {
+    uint8_t* rdram = ultramodern::get_rdram_base();
+    if (rdram == nullptr) {
+        return;
+    }
+    PTR(OSThread) self = ultramodern::this_thread();
+    int tid = (self != 0) ? TO_PTR(OSThread, self)->id : -1;
+    ultramodern::debug_dump_call_chain(tid, label);
