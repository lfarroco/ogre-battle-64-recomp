+// 0x08000000 = the SRAM window). OB64's save is 32 KiB SRAM and it goes through
+// this same path: the boot accessors func_80074CF0.. read the whole image in
+// 256-byte DMAs at device offsets 0..0x7F00, and the commit func_80074C58
+// writes it back the same way with direction 1 (OSIoMesg type 0x10 = EDMAWRITE;
+// 0xF = EDMAREAD). Session 66; see app/src/main.cpp entry.save_type.
+// -----------------------------------------------------------------------------
+
+// Defined below, after save_context; used by the inline DMA handler.
+void save_write(RDRAM_ARG PTR(void) rdram_address, uint32_t offset, uint32_t count);
+void save_read(RDRAM_ARG PTR(void) rdram_address, uint32_t offset, uint32_t count);
+
+// Queue address (KSEG0) the game sends DMA requests to. Lives in the reserved
+// MMIO scratch page (see recomp.h recomp_mem_addr), which nothing else uses.
+// Declared as int32 so TO_PTR's sign-extension (PTR() values) works on 64-bit.
+static constexpr int32_t PI_REQUEST_QUEUE = (int32_t)0x9F800000;  // rdram offset 0x1F800000
+static constexpr int32_t PI_MANAGER_STRUCT = (int32_t)0x9F800020; // __osPiDevMgr stand-in
+
+// OSIoMesgHdr.type values (libultra): what the game stores in func_8008BC40
+// from its direction argument.
+static constexpr uint16_t OS_MESG_TYPE_EDMAREAD = 0xF;
+static constexpr uint16_t OS_MESG_TYPE_EDMAWRITE = 0x10;
+
+// Perform the transfer an OSIoMesg describes, selecting the device from the PI
+// handle the message carries (libultra OSIoMesg.piHandle@0x14, whose
+// OSPiHandle.baseAddress is at +0xC):
+//   * baseAddress 0xA8000000 -> physical 0x08000000 = the battery-backed SRAM
+//     window (OB64's save). Reads/writes go to the runtime save image.
+//   * anything else (the cart handle from osCartRomInit: 0 or 0x10000000) -> ROM.
+// `force_dir` is func_8008BC40's direction argument (0 = device->RDRAM,
+// 1 = RDRAM->device) when the caller knows it; pass -1 to use the message type.
+static void pi_perform_dma(uint8_t* rdram, uint32_t mesg_addr, int force_dir) {
+    // OSIoMesg layout: hdr.type@0 (half), hdr.pri@2 (byte), hdr.retQueue@4,
+    // dramAddr@8, devAddr@0xC, size@0x10, piHandle@0x14.
+    uint16_t type     = (uint16_t)MEM_H(0x00, (gpr)(int32_t)mesg_addr);
+    uint32_t dramAddr = (uint32_t)MEM_W(0x08, (gpr)(int32_t)mesg_addr);
+    uint32_t devAddr  = (uint32_t)MEM_W(0x0C, (gpr)(int32_t)mesg_addr);
+    uint32_t size     = (uint32_t)MEM_W(0x10, (gpr)(int32_t)mesg_addr);
+    uint32_t handle   = (uint32_t)MEM_W(0x14, (gpr)(int32_t)mesg_addr);
+
+    // A zero handle means an older caller that did not record one: fall back to
+    // the historical ROM-only behaviour.
+    uint32_t base_phys = (handle != 0) ? ((uint32_t)MEM_W(0x0C, (gpr)(int32_t)handle) & 0x1FFFFFFF) : 0;
+    uint32_t phys = base_phys + devAddr;
+
+    OGRE_TRACE("[pi] inline DMA dram=0x%08X dev=0x%08X size=0x%X type=0x%X handle=0x%08X base=0x%08X\n",
+               dramAddr, devAddr, size, type, handle, base_phys);
+
+    if (base_phys == recomp::sram_base) {
+        // SRAM is at physical 0x08000000; the game addresses it in 256-byte
+        // DMAs covering the whole 32 KiB image.
+        if (!recomp::sram_allowed()) {
+            ultramodern::error_handling::message_box("Attempted to use SRAM saving with other save type");
+            ULTRAMODERN_QUICK_EXIT();
+        }
+        bool write = (force_dir >= 0) ? (force_dir != 0) : (type == OS_MESG_TYPE_EDMAWRITE);
+        if (write) {
+            static std::atomic_bool logged_write{false};
+            if (!logged_write.exchange(true)) {
+                printf("[save] game writes the battery (SRAM) save: dev=0x%08X size=0x%X\n", devAddr, size);
+                fflush(stdout);
+            }
+            save_write(PASS_RDRAM (PTR(void))(int32_t)dramAddr, phys - recomp::sram_base, size);
+        }
+        else {
+            static std::atomic_bool logged_read{false};
+            if (!logged_read.exchange(true)) {
+                printf("[save] game reads the battery (SRAM) save: dev=0x%08X size=0x%X\n", devAddr, size);
+                fflush(stdout);
+            }
+            save_read(PASS_RDRAM (PTR(void))(int32_t)dramAddr, phys - recomp::sram_base, size);
+        }
+    }
+    else if (devAddr == 0 || size == 0) {
+        OGRE_TRACE("[pi] inline DMA with zero dev/size; completing anyway\n");
+    }
+    else {
+        // ROM: devAddr is the cart offset (the cart handle's base is 0 or
+        // 0x10000000, so phys lands below the SRAM window).
+        uint32_t dev_off = (phys >= recomp::rom_base) ? (phys - recomp::rom_base) : devAddr;
+        recomp::do_rom_read(rdram, (gpr)(int32_t)dramAddr, recomp::rom_base + dev_off, size);
+    }
+}
+
+void init_pi_manager(uint8_t* rdram) {
+    // Write the game's PI-manager globals (D_800AA400/D_800AA408).
+    MEM_W(0, (gpr)(int32_t)0x800AA400) = (int32_t)PI_MANAGER_STRUCT;
+    MEM_W(0, (gpr)(int32_t)0x800AA408) = (int32_t)PI_REQUEST_QUEUE;
+
+    // Initialize the request queue struct + buffer in the scratch page.
+    auto* q = TO_PTR(OSMesgQueue, PI_REQUEST_QUEUE);
+    q->blocked_on_recv = NULLPTR;
+    q->blocked_on_send = NULLPTR;
+    q->validCount = 0;
+    q->first = 0;
+    q->msgCount = 8;
+    q->msg = (PTR(OSMesg))(int32_t)(PI_REQUEST_QUEUE + 0x18);
+
+    ultramodern::set_pi_request_queue(PI_REQUEST_QUEUE, [](uint8_t* rdram, uint32_t mesg_addr) {
+        uint32_t mq = (uint32_t)MEM_W(0x04, (gpr)(int32_t)mesg_addr);
+
+        pi_perform_dma(rdram, mesg_addr, -1);
+
+        // Complete the request synchronously: wake the caller's completion queue.
+        if (mq != 0) {
+            ultramodern::enqueue_external_message_src(mq, (OSMesg)(int32_t)mesg_addr, false,
+                                                      ultramodern::EventMessageSource::Pi);
+        }
+    });
+
+    printf("[pi] PI manager initialized (queue=0x%08X)\n", PI_REQUEST_QUEUE);
+}
+
+
+// func_8008BC40 (OB64 game code): the game's DMA-request starter. On real
+// hardware it queues the OSIoMesg to the PI thread. The runtime's
+// osCreatePiManager is stubbed, so init_pi_manager installs the game's
+// PI-manager globals (D_800AA400/D_800AA408) and intercepts sends to that queue
+// in do_send; direct callers therefore already work. This entry point exists for
+// a caller that reaches the function through the recompiled function table
+// instead: it performs the same transfer synchronously via pi_perform_dma (ROM
+// or battery save, chosen from the message's PI handle) and completes the queue.
+extern "C" void func_8008BC40_recomp(uint8_t* rdram, recomp_context* ctx) {
+    // a0 = PI handle, a1 = OSIoMesg*, a2 = dir (0 = read, 1 = write).
+    uint32_t mesg = (uint32_t)ctx->r5;
+    if (mesg == 0) {
+        ctx->r2 = (gpr)-1;
+        return;
+    }
+
+    uint32_t mq  = MEM_W(0x04, (gpr)(int32_t)mesg);
+    uint32_t dir = (uint32_t)ctx->r6;
+
+    printf("[pi] func_8008BC40 dir=%u dram=0x%08X dev=0x%08X size=0x%X mq=0x%08X\n",
+           dir, MEM_W(0x08, (gpr)(int32_t)mesg), MEM_W(0x0C, (gpr)(int32_t)mesg),
+           MEM_W(0x10, (gpr)(int32_t)mesg), mq);
+    fflush(stdout);
+
+    // Same device selection as the queue path: ROM, or the battery save when
+    // the message carries the SRAM handle (see pi_perform_dma).
+    pi_perform_dma(rdram, mesg, (int)dir);
+
+    // Complete the request synchronously so the caller's osRecvMesg returns.
+    osSendMesg(rdram, (int32_t)mq, (OSMesg)(int32_t)mesg, OS_MESG_NOBLOCK);
+
+    ctx->r2 = 0;
 }
 
