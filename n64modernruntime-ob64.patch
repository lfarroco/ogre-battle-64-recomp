+// -----------------------------------------------------------------------------
+// External-message drainer thread.
+//
+// The runtime delivers hardware events (VI retrace, AI/SP/SI interrupts, timers)
+// to game threads through an "external message" queue that is only drained when a
+// game thread calls osSendMesg/osRecvMesg/osJamMesg. Games whose boot path blocks
+// every game thread on a queue fed by such an event (e.g. Ogre Battle 64's audio
+// thread waiting for the VI-retrace message, with its main thread busy-spinning)
+// deadlock because nothing ever drains the queue.
+//
+// This hidden game thread continuously drains external messages and runs any
+// thread that was woken, so blocked threads make progress regardless of whether
+// the game itself is actively sending/recv'ing.
+// -----------------------------------------------------------------------------
+
+// Entry point for the drainer thread. Registered in the function map at a fixed
+// VRAM address so run_thread_function can dispatch to it; runs forever (like
+// pause_self), so it must be a unique entry not reachable from game code.
+extern "C" void external_message_drainer_entry(uint8_t* rdram, recomp_context* ctx) {
+    printf("[drainer] external-message drainer thread started\n");
+    while (true) {
+        printf("[drainer] T=%llu waiting for external message\n", (unsigned long long)ultramodern::trace_millis());
+        ultramodern::wait_for_external_message(rdram);
+        printf("[drainer] T=%llu got external message, checking running queue\n", (unsigned long long)ultramodern::trace_millis());
+        ultramodern::check_running_queue(rdram);
+        printf("[drainer] T=%llu back from check_running_queue\n", (unsigned long long)ultramodern::trace_millis());
+    }
+}
+
+extern "C" void func_80089A10_recomp(uint8_t* rdram, recomp_context* ctx) {
+    // func_80089A10 (game code): "spin until the RSP task-done counter
+    // (D_800E79A4) reaches zero". The runtime's cooperative scheduler cannot
+    // preempt a busy-spinning game thread, so this spin (thread pri 10) starves
+    // the external-message drainer (pri 5) that must deliver the SP/DP completion
+    // events which eventually decrement the counter -> boot deadlocks after the
+    // first RSP task. Reimplemented as a yielding wait: drain external messages
+    // (SP/DP completions) and hand off to higher-priority task threads.
+    while (MEM_W(0, (gpr)(int32_t)0x800E79A4) != 0) {
+        ultramodern::wait_for_external_message(rdram);
+        ultramodern::check_running_queue(rdram);
+    }
+}
