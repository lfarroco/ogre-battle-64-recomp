+// Debug: deliver a synthetic PRENMI (0x29D) to the game's VI-manager queue.
+// The game only advances its boot phase (D_800C4800) when the VI manager
+// receives 0x29D, which fans out the mask-2 flags (D_800E8B12) that the
+// audio/system threads process per frame; the runtime never sends 0x29D
+// otherwise. Exported as ogre_send_prnmi for bring-up testing. Delivered
+// directly (not via the external queue, which can have a large retrace
+// backlog that would delay it).
+// Pending direct sends, delivered by game threads (drainer / dequeue_external_messages)
+// so the queue/scheduler manipulation happens in a game-thread context (the
+// cooperative scheduler is not thread-safe against foreign do_send calls).
+struct PendingDirectSend {
+    int32_t mq;
+    int32_t msg;
+    bool jam;
+    int retries_left;
+};
+static std::mutex pending_direct_mutex;
+static std::vector<PendingDirectSend> pending_direct_sends;
+
+void ultramodern::deliver_pending_direct_sends(RDRAM_ARG1) {
+    std::vector<PendingDirectSend> to_send;
+    {
+        std::lock_guard lock{pending_direct_mutex};
+        pending_direct_sends.swap(to_send);
+    }
+    std::vector<PendingDirectSend> retry{};
+    for (const auto& pd : to_send) {
+        printf("[dbg] T=%llu delivering direct send to queue 0x%08X msg=0x%08X\n",
+               (unsigned long long)ultramodern::trace_millis(), (uint32_t)pd.mq, (uint32_t)pd.msg);
+        if (!do_send(PASS_RDRAM (PTR(OSMesgQueue))pd.mq, (OSMesg)pd.msg, pd.jam, false)) {
+            // Queue full: keep the message for a later retry so it is not lost.
+            if (pd.retries_left > 0) {
+                PendingDirectSend r = pd;
+                r.retries_left--;
+                retry.push_back(r);
+            } else {
+                printf("[dbg] giving up direct send to queue 0x%08X msg=0x%08X (queue stayed full)\n",
+                       (uint32_t)pd.mq, (uint32_t)pd.msg);
+            }
+        }
+    }
+    if (!retry.empty()) {
+        std::lock_guard lock{pending_direct_mutex};
+        for (auto& r : retry) {
+            pending_direct_sends.push_back(r);
+        }
+    }
+}
+
+void ultramodern::debug_send_prnmi() {
+    printf("[dbg] queueing synthetic PRENMI (0x29D) for VI-manager queue\n");
+    std::lock_guard lock{pending_direct_mutex};
+    pending_direct_sends.push_back({(int32_t)0x800E8B84, (int32_t)0x29D, true, 100});
+}
