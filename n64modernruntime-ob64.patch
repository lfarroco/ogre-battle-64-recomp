diff --git a/ultramodern/src/function_trace.cpp b/ultramodern/src/function_trace.cpp
new file mode 100644
index 0000000..786872e
--- /dev/null
+++ b/ultramodern/src/function_trace.cpp
@@ -0,0 +1,925 @@
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <mutex>
+#include <thread>
+#include <utility>
+
+#include "ultramodern/ultramodern.hpp"
+#include "ultramodern/ultra64.h"
+
+// The runtime's global exit flag (threads.cpp).
+extern std::atomic_bool exited;
+
+// Per-thread "currently executing recompiled function" tracking for deadlock
+// diagnostics. The recompiled code calls recomp_trace_func() at every function
+// entry (emitted by N64Recomp's emit_function_start); the VI thread's queue
+// snapshot reads it via debug_last_func_vram() to show where a stuck game
+// thread is executing. Best-effort and racy by design (diagnostics only).
+struct recomp_context;
+
+static std::array<std::atomic<uint32_t>, 256> last_func_vram{};
+
+// Session-26: per-thread shadow call chain.
+//
+// "last function entered" cannot say where a thread is actually stuck: the
+// recompiled code only reports function ENTRY, so a thread sitting in a leaf
+// helper (e.g. the icache flush func_800901C0) reports the helper, not its
+// caller. The codegen now emits recomp_trace_entry at every function start
+// (with ctx->r31, the address in the caller to return to) and
+// recomp_trace_return before every return, so this is a real live stack: the
+// tail is where the thread is, and every frame names its caller.
+//
+// Threads are native 1:1 with game threads, so only this thread writes its own
+// slot. The read side (VI thread's snapshot, and a foreign thread dumping a
+// blocked thread) tolerates a torn read: it prints a wrong frame, never faults.
+struct CallChainEntry {
+    uint32_t ra;        // return address inside the CALLER (0 = bottom of chain)
+    uint32_t func;      // callee vram
+    const char* name;   // callee name
+    uint64_t seq;       // monotonically increasing entry sequence number
+    uint64_t end;       // seq of the return that left this frame (0 = live)
+};
+
+static constexpr int kCallChainDepth = 64;
+// Padding to a cache line keeps neighbouring threads from bouncing the line.
+struct alignas(64) ThreadCallChain {
+    uint64_t next_seq = 1;  // next entry sequence number for this thread
+    uint32_t depth = 0;     // number of entries stored (may exceed the array)
+    CallChainEntry entries[kCallChainDepth]{};
+};
+static std::array<ThreadCallChain, 256> call_chains{};
+
+// Session-18: allocator entry ring. recomp_trace_entry() sees only the function
+// address (no registers), but the ENTRY SEQUENCE per thread distinguishes a
+// genuine malloc->search call chain from a return-address-smash landing
+// directly in the search. Filtered to the allocator family to bound volume.
+struct AllocEvent {
+    uint32_t tid = 0;
+    uint32_t func = 0;
+    uint64_t tick = 0;
+};
+static std::array<AllocEvent, 128> alloc_ring{};
+static std::atomic<uint64_t> alloc_ring_next{0};
+
+static bool is_alloc_func(uint32_t func_vram) {
+    return func_vram == 0x80070F30 || func_vram == 0x800710DC ||
+           func_vram == 0x80071A3C || func_vram == 0x80071E74 ||
+           func_vram == 0x80071950 || func_vram == 0x800719E8;
+}
+
+// Entry hook: records the executing function, pushes the frame onto the
+// per-thread shadow call chain, and feeds the allocator ring. The generated
+// prologue calls this with ctx->r31, which at function entry still holds the
+// address in the caller that this frame will return to.
+// The per-function-entry hooks (recomp_trace_entry/recomp_trace_return) run on
+// EVERY recompiled function entry - millions of times per second - and write a
+// shadow call chain plus the last-function slot each time. That is far too
+// expensive to leave on for a normal run: it is a diagnostic, so it is enabled
+// only when a diagnostic that consumes it is requested
+// (OGRE_PROFILE / OGRE_COVER / OGRE_SCHED_TRACE / OGRE_DEBUG_TRACES /
+// OGRE_TRACE_HOOKS).
+// OGRE_COVER's value says where the census goes: unset / "" / "0" = off,
+// "1" = stdout (pipe or `tee` it), anything else = that file path. A coverage
+// session is played by hand and its output is thousands of lines at the end of a
+// very chatty run, so writing the census to its own file is the form that does
+// not depend on remembering to redirect; `OGRE_COVER=1` stays for scripted runs.
+static const char* cover_output(void) {
+    static const char* const value = [] () -> const char* {
+        const char* v = getenv("OGRE_COVER");
+        if (v == nullptr || v[0] == '\0' || (v[0] == '0' && v[1] == '\0')) {
+            return nullptr;
+        }
+        if (v[0] == '1' && v[1] == '\0') {
+            return "";
+        }
+        return v;
+    }();
+    return value;
+}
+
+static bool trace_hooks_enabled() {
+    static const bool enabled = [] {
+        return getenv("OGRE_TRACE_HOOKS") != nullptr ||
+               getenv("OGRE_PROFILE") != nullptr ||
+               cover_output() != nullptr ||
+               getenv("OGRE_SCHED_TRACE") != nullptr ||
+               getenv("OGRE_DEBUG_TRACES") != nullptr;
+    }();
+    return enabled;
+}
+
+// The *expensive* half of the hooks: the per-thread last-function slot, the
+// per-thread entry counter and the shadow call chain, all of which write
+// several words and an atomic per entry/return. `OGRE_COVER` needs none of
+// them -- it only counts distinct functions -- so a coverage run skips this and
+// is the difference between a playthrough being measurable and not. Every other
+// consumer (the profiler, the scheduler trace, `debug_dump_call_chain`) needs
+// it, so this is the original set minus OGRE_COVER.
+static bool heavy_traces_enabled() {
+    static const bool enabled = [] {
+        return getenv("OGRE_TRACE_HOOKS") != nullptr ||
+               getenv("OGRE_PROFILE") != nullptr ||
+               getenv("OGRE_SCHED_TRACE") != nullptr ||
+               getenv("OGRE_DEBUG_TRACES") != nullptr;
+    }();
+    return enabled;
+}
+
+// Per-thread recompiled-function entry counts. A thread whose count is not
+// advancing is blocked or idle in a runtime call; one whose count advances is
+// executing game code. This is the "is it computing or waiting?" signal the
+// sampling profiler cannot get from last_func_vram alone.
+struct alignas(64) EntryCounter {
+    std::atomic<uint64_t> n{0};
+};
+static std::array<EntryCounter, 256> entry_counts{};
+
+// --- checkpoint pause barrier (session 58) ---------------------------------
+//
+// `checkpoint_pause_begin` (main thread) sets `checkpoint_pause_on`, waits for
+// every thread executing recompiled code to park at a function-entry boundary,
+// and returns; `checkpoint_pause_end` releases them. See the declarations in
+// ultramodern.hpp for why the save state needs this.
+//
+// The flag is read by every recompiled function entry, so it is a plain relaxed
+// atomic load and an almost-never-taken branch; the mutex/condvar protocol only
+// runs while a checkpoint is in progress.
+static std::atomic<bool> checkpoint_pause_on{false};
+static std::mutex checkpoint_mutex;
+static std::condition_variable checkpoint_cv;
+static int checkpoint_parked = 0;
+
+// Park the calling thread if a checkpoint is in progress. Called from
+// recomp_trace_entry, i.e. at a function boundary, so the guest state is a
+// consistent point to freeze.
+static void checkpoint_maybe_park() {
+    if (!checkpoint_pause_on.load(std::memory_order_relaxed)) {
+        return;
+    }
+    std::unique_lock<std::mutex> lock(checkpoint_mutex);
+    if (!checkpoint_pause_on.load(std::memory_order_relaxed)) {
+        return;
+    }
+    ++checkpoint_parked;
+    checkpoint_cv.notify_all();
+    checkpoint_cv.wait(lock, [] { return !checkpoint_pause_on.load(std::memory_order_relaxed); });
+    --checkpoint_parked;
+}
+
+int ultramodern::checkpoint_pause_begin() {
+    if (checkpoint_pause_on.exchange(true)) {
+        return -1;  // already paused: nested begin is a bug in the caller
+    }
+    // A thread already inside a recompiled function can only park when that
+    // function returns. The longest recompiled function in this ROM runs in
+    // microseconds, so a 50 ms grace window is far longer than any in-flight
+    // frame; after it, every thread executing game code has parked (and any
+    // thread that starts executing afterwards parks at its first entry).
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    std::lock_guard<std::mutex> lock(checkpoint_mutex);
+    return checkpoint_parked;
+}
+
+void ultramodern::checkpoint_pause_end() {
+    {
+        std::lock_guard<std::mutex> lock(checkpoint_mutex);
+        checkpoint_pause_on.store(false, std::memory_order_relaxed);
+    }
+    checkpoint_cv.notify_all();
+}
+
+// Set once by debug_profile_start(); forward-declared so the entry hook can
+// feed the hot-function table without a second definition.
+static std::atomic<bool> profile_on{false};
+
+// Per-function entry counts for the OGRE_PROFILE hot-function report. The
+// cooperative scheduler runs one game thread at a time, so this open-addressed
+// table is touched from a single game thread at any instant; probes from the
+// profiler thread at report time only ever see a torn count, never a fault.
+static constexpr size_t kFuncCountSlots = 8192;
+static uint32_t func_count_key[kFuncCountSlots];
+static uint64_t func_count_val[kFuncCountSlots];
+
+static inline void bump_func_count(uint32_t func_vram) {
+    size_t idx = (func_vram >> 2) & (kFuncCountSlots - 1);
+    for (size_t p = 0; p < 16; p++) {
+        size_t s = (idx + p) & (kFuncCountSlots - 1);
+        if (func_count_key[s] == func_vram) {
+            func_count_val[s]++;
+            return;
+        }
+        if (func_count_key[s] == 0) {
+            func_count_key[s] = func_vram;
+            func_count_val[s] = 1;
+            return;
+        }
+    }
+}
+
+uint64_t ultramodern::debug_entry_count(int tid) {
+    if (tid < 0 || tid >= (int)entry_counts.size()) {
+        return 0;
+    }
+    return entry_counts[tid].n.load(std::memory_order_relaxed);
+}
+
+uint64_t ultramodern::debug_total_entry_count(void) {
+    uint64_t total = 0;
+    for (auto& c : entry_counts) {
+        total += c.n.load(std::memory_order_relaxed);
+    }
+    return total;
+}
+
+extern "C" void recomp_trace_entry(uint8_t *rdram, uint32_t func_vram, const char* func_name, uint32_t ra) {
+    (void)rdram;
+    // Checkpoint support: park at a function boundary while the main thread
+    // reads or rewrites the whole RDRAM image. This is first because it must not
+    // depend on OGRE_TRACE_HOOKS, and it is a relaxed atomic load in the normal
+    // case (the branch below is never taken).
+    checkpoint_maybe_park();
+    if (!trace_hooks_enabled()) {
+        return;
+    }
+    // Coverage needs the counter and nothing else: feeding it here, before the
+    // thread lookup and the chain, keeps an OGRE_COVER playthrough near normal
+    // speed (the hash insert is the only cost per entry).
+    if (profile_on.load(std::memory_order_relaxed)) {
+        bump_func_count(func_vram);
+    }
+    if (!heavy_traces_enabled()) {
+        return;
+    }
+    PTR(OSThread) self = ultramodern::this_thread();
+    if (self == 0) {
+        return;
+    }
+    int tid = TO_PTR(OSThread, self)->id;
+    if (tid < 0 || tid >= (int)last_func_vram.size()) {
+        return;
+    }
+    last_func_vram[tid].store(func_vram, std::memory_order_relaxed);
+    entry_counts[tid].n.fetch_add(1, std::memory_order_relaxed);
+
+    ThreadCallChain& chain = call_chains[tid];
+    uint32_t depth = chain.depth;
+    if (depth < (uint32_t)kCallChainDepth) {
+        CallChainEntry& e = chain.entries[depth];
+        e.ra = ra;
+        e.func = func_vram;
+        e.name = func_name;
+        e.seq = chain.next_seq++;
+        e.end = 0;
+        chain.depth = depth + 1;
+    }
+
+    if (is_alloc_func(func_vram)) {
+        uint64_t i = alloc_ring_next.fetch_add(1, std::memory_order_relaxed);
+        AllocEvent ev;
+        ev.tid = (uint32_t)tid;
+        ev.func = func_vram;
+        ev.tick = i;
+        alloc_ring[i % alloc_ring.size()] = ev;
+    }
+}
+
+// Return hook: close the innermost live frame. Walk down from the newest entry
+// so a missed hook (or a tail call) cannot corrupt the chain. func_index is the
+// recompiled function id; it is only used to sanity-check the popped frame when
+// it is cheap to do so.
+extern "C" void recomp_trace_return(uint8_t *rdram, size_t func_index) {
+    (void)func_index;
+    // A coverage run has no call chain to close (see recomp_trace_entry).
+    if (!heavy_traces_enabled()) {
+        return;
+    }
+    PTR(OSThread) self = ultramodern::this_thread();
+    if (self == 0) {
+        return;
+    }
+    int tid = TO_PTR(OSThread, self)->id;
+    if (tid < 0 || tid >= (int)call_chains.size()) {
+        return;
+    }
+    ThreadCallChain& chain = call_chains[tid];
+    uint32_t depth = chain.depth;
+    if (depth == 0) {
+        return;
+    }
+    if (depth > (uint32_t)kCallChainDepth) {
+        // Saturated (recursion deeper than the array): just account for it.
+        chain.depth = depth - 1;
+        return;
+    }
+    // A function that returns without a matching entry (e.g. tail-call shims)
+    // is possible; the newest live frame may not be ours, in which case leave
+    // the chain alone rather than dropping a live frame.
+    CallChainEntry& e = chain.entries[depth - 1];
+    e.end = chain.next_seq - 1;
+    chain.depth = depth - 1;
+}
+
+// Newest-first dump of the allocator ring for the snapshot (diagnostics only).
+void ultramodern::debug_dump_alloc_ring(void) {
+    uint64_t next = alloc_ring_next.load(std::memory_order_relaxed);
+    uint64_t n = next < alloc_ring.size() ? next : alloc_ring.size();
+    printf("[snap] alloctrace: last %llu alloc-family entries (tid:func):",
+           (unsigned long long)n);
+    for (uint64_t k = 0; k < n; k++) {
+        uint64_t i = (next - 1 - k) % alloc_ring.size();
+        const AllocEvent &ev = alloc_ring[i];
+        if (k % 8 == 0) {
+            printf("\n[snap] alloctrace: ");
+        }
+        printf(" t%d:%08X", ev.tid, ev.func);
+    }
+    printf("\n");
+}
+
+// Session-18: allocator transition sampler. A dedicated host thread polls
+// last_func_vram[] ~1kHz and records transitions into/out of the allocator
+// family with the predecessor function (the malloc caller). Reads only;
+// game timing is unaffected (atomic loads, sampler sleeps between polls).
+struct AllocTrans {
+    uint32_t tid = 0;
+    uint32_t from = 0;
+    uint32_t to = 0;
+};
+static std::array<AllocTrans, 512> trans_ring{};
+static std::atomic<uint64_t> trans_ring_next{0};
+static std::array<uint32_t, 64> trans_prev{};
+static std::thread trans_sampler_thread{};
+static std::atomic<bool> trans_sampler_started{false};
+
+static void trans_sampler_main(void) {
+    while (true) {
+        for (int tid = 0; tid < 64; tid++) {
+            uint32_t cur = last_func_vram[tid].load(std::memory_order_relaxed);
+            uint32_t prev = trans_prev[tid];
+            if (cur != prev) {
+                trans_prev[tid] = cur;
+                if (is_alloc_func(cur) || is_alloc_func(prev)) {
+                    uint64_t i = trans_ring_next.fetch_add(1, std::memory_order_relaxed);
+                    AllocTrans ev;
+                    ev.tid = (uint32_t)tid;
+                    ev.from = prev;
+                    ev.to = cur;
+                    trans_ring[i % trans_ring.size()] = ev;
+                }
+            }
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(1000));
+    }
+}
+
+// Chain-history sampler (session 26): a dedicated host thread polls the
+// shadow chain of the boot thread and records the LIVE FRAME SEQUENCE (frames
+// that were on the stack at some sample), so a wedge can be read as a path
+// rather than a single state. Controlled by OGRE_CHAIN_HISTORY=<tid>.
+struct ChainEvent {
+    uint64_t tick = 0;
+    uint32_t tid = 0;
+    uint32_t func = 0;
+    const char* name = nullptr;
+};
+static std::array<ChainEvent, 256> chain_hist{};
+static std::atomic<uint64_t> chain_hist_next{0};
+static std::thread chain_sampler_thread{};
+static std::atomic<bool> chain_sampler_started{false};
+
+static void chain_sampler_main(int tid) {
+    std::vector<uint32_t> prev;
+    while (true) {
+        std::vector<uint32_t> cur;
+        if (tid >= 0 && tid < (int)call_chains.size()) {
+            const ThreadCallChain& chain = call_chains[tid];
+            uint32_t depth = chain.depth;
+            if (depth > (uint32_t)kCallChainDepth) depth = (uint32_t)kCallChainDepth;
+            for (uint32_t i = 0; i < depth; i++) {
+                const CallChainEntry& e = chain.entries[i];
+                if (e.end > e.seq) continue;      // dead frame
+                if (e.end != 0) continue;         // closed frame
+                cur.push_back(e.func);
+            }
+        }
+        if (cur != prev) {
+            prev = cur;
+            for (uint32_t f : cur) {
+                uint64_t i = chain_hist_next.fetch_add(1, std::memory_order_relaxed);
+                ChainEvent& ev = chain_hist[i % chain_hist.size()];
+                ev.tick = i;
+                ev.tid = (uint32_t)tid;
+                ev.func = f;
+                ev.name = nullptr;
+            }
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(200));
+    }
+}
+
+void ultramodern::debug_chain_history_start(int tid) {
+    bool expected = false;
+    if (chain_sampler_started.compare_exchange_strong(expected, true)) {
+        chain_sampler_thread = std::thread{chain_sampler_main, tid};
+        chain_sampler_thread.detach();
+    }
+}
+
+void ultramodern::debug_dump_chain_history(void) {
+    uint64_t next = chain_hist_next.load(std::memory_order_relaxed);
+    uint64_t n = next < chain_hist.size() ? next : chain_hist.size();
+    printf("[snap] chainhistory: last %llu entries (grouped):", (unsigned long long)n);
+    uint32_t last_func = 0;
+    for (uint64_t k = 0; k < n; k++) {
+        uint64_t i = (next - n + k) % chain_hist.size();
+        const ChainEvent& ev = chain_hist[i];
+        if (ev.func != last_func) {
+            printf("\n[snap]   ");
+        }
+        printf(" %08X", ev.func);
+        last_func = ev.func;
+    }
+    printf("\n");
+}
+
+void ultramodern::debug_alloc_trans_start(void) {
+    bool expected = false;
+    if (trans_sampler_started.compare_exchange_strong(expected, true)) {
+        trans_sampler_thread = std::thread{trans_sampler_main};
+        trans_sampler_thread.detach();
+    }
+}
+
+void ultramodern::debug_dump_alloc_trans(void) {
+    debug_alloc_trans_start();
+    uint64_t next = trans_ring_next.load(std::memory_order_relaxed);
+    uint64_t n = next < trans_ring.size() ? next : trans_ring.size();
+    if (n == 0) {
+        printf("[snap] alloctrans: (none)\n");
+        return;
+    }
+    printf("[snap] alloctrans: last %llu transitions into/out of alloc (tid:from->to):",
+           (unsigned long long)n);
+    for (uint64_t k = 0; k < n; k++) {
+        uint64_t i = (next - 1 - k) % trans_ring.size();
+        const AllocTrans &ev = trans_ring[i];
+        if (k % 4 == 0) {
+            printf("\n[snap] alloctrans: ");
+        }
+        printf(" t%d:%08X->%08X", ev.tid, ev.from, ev.to);
+    }
+    printf("\n");
+}
+
+uint32_t ultramodern::debug_last_func_vram(int tid) {
+    if (tid < 0 || tid >= (int)last_func_vram.size()) {
+        return 0;
+    }
+    return last_func_vram[tid].load(std::memory_order_relaxed);
+}
+
+// ---------------------------------------------------------------------------
+// Scheduler event ring (session 28).
+//
+// The [Sched]-gated printf traces are emitted from several host threads and go
+// through a buffered stdout, so their ordering cannot be trusted - and the
+// question here ("who removed thread 3 from the running queue without resuming
+// it?") is entirely about ordering and about a wakeup that never happened.
+// This ring records every scheduler operation with a global atomic sequence
+// number, so the dump at exit is a true total order of what the scheduler did.
+//
+// Kinds:
+//   0 insert   1 pop   2 remove   3 resume   4 park   5 wake
+//   6 swap     7 block 8 unblock
+// a = the thread the event is about, b = the thread that caused it (-1 = none).
+struct SchedEvent {
+    uint64_t seq;
+    uint64_t tick;   // trace_millis() at the event: the ring's only wall clock
+    int16_t kind;
+    int16_t a;
+    int16_t b;
+    int16_t rq[4];   // running-queue tids right after the event (-1 = slot unused)
+};
+
+static constexpr size_t kSchedRingSize = 16384;
+static std::array<SchedEvent, kSchedRingSize> sched_ring{};
+static std::atomic<uint64_t> sched_ring_next{0};
+static std::atomic<bool> sched_ring_on{false};
+
+// Set once by the app/runtime when OGRE_SCHED_TRACE=1: recording is cheap but
+// not free, and it is a diagnostic.
+void ultramodern::debug_sched_ring_set_enabled(bool enabled) {
+    sched_ring_on.store(enabled, std::memory_order_relaxed);
+}
+
+void ultramodern::debug_sched_event(int kind, int a, int b) {
+    if (!sched_ring_on.load(std::memory_order_relaxed)) {
+        return;
+    }
+    uint64_t i = sched_ring_next.fetch_add(1, std::memory_order_relaxed);
+    SchedEvent& ev = sched_ring[i % kSchedRingSize];
+    ev.seq = i;
+    ev.tick = ultramodern::trace_millis();
+    ev.kind = (int16_t)kind;
+    ev.a = (int16_t)a;
+    ev.b = (int16_t)b;
+    ev.rq[0] = ev.rq[1] = ev.rq[2] = ev.rq[3] = -1;
+    if (uint8_t* base = ultramodern::get_rdram_base()) {
+        ultramodern::debug_running_queue_snapshot(base, ev.rq, 4);
+    }
+}
+
+// Convenience: record an event about thread `a`, caused by the current thread.
+// Uses get_rdram_base() rather than TO_PTR because the call sites are scheduler
+// internals that do not all carry an rdram argument.
+void ultramodern::debug_sched_event_here(int kind, int a) {
+    if (!sched_ring_on.load(std::memory_order_relaxed)) {
+        return;
+    }
+    uint8_t* base = ultramodern::get_rdram_base();
+    PTR(OSThread) self = ultramodern::this_thread();
+    int b = -1;
+    if (base != nullptr && self != 0) {
+        b = ((OSThread*)(&base[(uint64_t)self - 0xFFFFFFFF80000000ull]))->id;
+    }
+    debug_sched_event(kind, a, b);
+}
+
+void ultramodern::debug_dump_sched_ring(int only_a) {
+    static const char* kNames[] = {"insert", "pop", "remove", "resume",
+                                   "park", "wake", "swap", "block", "unblock"};
+    uint64_t next = sched_ring_next.load(std::memory_order_relaxed);
+    uint64_t n = next < kSchedRingSize ? next : kSchedRingSize;
+    printf("[sched-ring] %llu events (showing last %llu%s):\n",
+           (unsigned long long)next, (unsigned long long)n,
+           only_a >= 0 ? ", filtered" : "");
+    for (uint64_t k = 0; k < n; k++) {
+        // Compare the stored sequence number against the global sequence this
+        // slot should hold, not against the slot index: seq is a monotonically
+        // increasing counter, so once it passes kSchedRingSize it never equals
+        // its own slot index and every event in a wrapped ring was dropped
+        // (only the first 16384 events of a long run were ever printed).
+        uint64_t seq = next - n + k;
+        uint64_t i = seq % kSchedRingSize;
+        const SchedEvent& ev = sched_ring[i];
+        if (ev.seq != seq) {
+            continue;   // slot not written yet (torn read of the ring index)
+        }
+        if (only_a >= 0 && ev.a != only_a && ev.b != only_a) {
+            continue;
+        }
+        const char* name = (ev.kind >= 0 && ev.kind < 9) ? kNames[ev.kind] : "?";
+        char rqbuf[64];
+        int off = 0;
+        for (int s = 0; s < 4 && ev.rq[s] >= 0; s++) {
+            off += snprintf(rqbuf + off, sizeof(rqbuf) - off, "%s%d", s ? "," : "", ev.rq[s]);
+        }
+        if (off == 0) {
+            snprintf(rqbuf, sizeof(rqbuf), "-");
+        }
+        printf("[sched-ring] %6llu t=%-6llu %-7s t%d by t%d  rq=[%s]\n",
+               (unsigned long long)ev.seq, (unsigned long long)ev.tick, name, ev.a, ev.b, rqbuf);
+    }
+}
+
+// Hot-loop sampler (diagnostic): sample last_func_vram[tid] 100x at ~200us
+// intervals and print the histogram. A thread stuck in a tight loop shows its
+// loop-nest functions; a parked/dead thread shows a single value. Called from
+// the VI thread's snapshot (~20ms per sampled thread).
+void ultramodern::debug_sample_hot_loop(int tid) {
+    if (tid < 0 || tid >= (int)last_func_vram.size()) {
+        return;
+    }
+    struct Entry { uint32_t vram = 0; int count = 0; };
+    Entry hist[16] = {};
+    int distinct = 0;
+    for (int i = 0; i < 100; i++) {
+        uint32_t v = last_func_vram[tid].load(std::memory_order_relaxed);
+        int j = 0;
+        for (; j < distinct; j++) {
+            if (hist[j].vram == v) { hist[j].count++; break; }
+        }
+        if (j == distinct && distinct < 16) {
+            hist[distinct].vram = v;
+            hist[distinct].count = 1;
+            distinct++;
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(200));
+    }
+    printf("[snap] hotloop t%d:", tid);
+    for (int j = 0; j < distinct; j++) {
+        printf(" 0x%08X x%d", hist[j].vram, hist[j].count);
+    }
+    printf("\n");
+}
+
+// Print the live shadow call chain recorded for a thread, outermost frame
+// first. Frames whose `end` sequence is hotter than the frame's own entry are
+// dead (the function returned); only live frames are printed, so the last line
+// is where the thread is right now. Diagnostic only: a torn read from a
+// concurrently-running thread prints a wrong frame or address, never faults.
+// Set once by recomp::start (librecomp) so runtime-side diagnostics can reach
+// the game's memory.
+static std::atomic<uint8_t*> rdram_base{nullptr};
+
+void ultramodern::set_rdram_base(uint8_t* base) {
+    rdram_base.store(base, std::memory_order_relaxed);
+}
+
+uint8_t* ultramodern::get_rdram_base() {
+    return rdram_base.load(std::memory_order_relaxed);
+}
+
+void ultramodern::debug_dump_call_chain(int tid, const char* label) {
+    if (tid < 0 || tid >= (int)call_chains.size()) {
+        return;
+    }
+    const ThreadCallChain& chain = call_chains[tid];
+    uint32_t depth = chain.depth;
+    if (depth > (uint32_t)kCallChainDepth) {
+        printf("[snap] callchain t%d %s: SATURATED (%u deep, array %d)\n",
+               tid, label, depth, kCallChainDepth);
+        depth = (uint32_t)kCallChainDepth;
+    }
+    printf("[snap] callchain t%d %s (%u deep, outermost first):", tid, label, depth);
+    int printed = 0;
+    for (uint32_t i = 0; i < depth; i++) {
+        const CallChainEntry& e = chain.entries[i];
+        // Live iff no return has closed this frame since it was entered.
+        if (e.end > e.seq) {
+            continue;
+        }
+        if (printed % 3 == 0) {
+            printf("\n[snap]   ");
+        }
+        // ra is the address in the CALLER just after its call to this frame.
+        printf(" %s(called from 0x%08X)", e.name != nullptr ? e.name : "?", e.ra);
+        printed++;
+    }
+    if (printed == 0) {
+        printf(" (no live frames)");
+    }
+    printf("\n");
+    // Also print the tail of recent entries by sequence number, so the dump
+    // shows the path a thread *took* to get here, not only where it stopped.
+    uint32_t total = chain.depth < (uint32_t)kCallChainDepth ? chain.depth : (uint32_t)kCallChainDepth;
+    if (total > 0) {
+        printf("[snap]   recent entries (newest last):");
+        uint32_t shown = 0;
+        for (uint32_t i = 0; i < total; i++) {
+            const CallChainEntry& e = chain.entries[i];
+            if (e.end != 0 && e.end < e.seq) {
+                continue;
+            }
+            if (e.end != 0) {
+                continue;   // only frames still on the stack
+            }
+            if (shown >= 12) {
+                break;
+            }
+            printf(" %s(0x%08X)", e.name != nullptr ? e.name : "?", e.ra);
+            shown++;
+        }
+        printf("\n");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Sampling profiler (OGRE_PROFILE=1).
+//
+// The scheduler ring and the VI snapshot can say that the game threads are
+// running and that no display list is being submitted, but not *what* the game
+// is executing during that time. This samples every game thread's last-entered
+// recompiled function (updated at every function entry by recomp_trace_entry)
+// on a timer and accumulates a (tid, function) histogram, dumped at exit and
+// resolved to function names with `nm` off the binary.
+//
+// Sampling (rather than instrumenting every entry with a clock) keeps the
+// measurement faithful: a recompiled function is entered millions of times per
+// second, so a clock read per entry would itself dominate the run.
+namespace {
+struct ProfileEntry {
+    uint32_t tid;
+    uint32_t func;
+    uint64_t count;
+};
+constexpr size_t kProfileSlots = 2048;
+ProfileEntry profile_table[kProfileSlots];
+size_t profile_used = 0;
+std::mutex profile_mutex;
+std::thread profile_thread;
+uint64_t profile_last_entry_counts[256] = {};
+}  // namespace
+
+void ultramodern::debug_profile_start(void) {
+    if (profile_on.exchange(true)) {
+        return;
+    }
+    profile_thread = std::thread([] {
+        const int tids[] = {1, 3, 4, 5, 16, 17, 18, 19, 50, 200};
+        auto next_report = std::chrono::steady_clock::now() + std::chrono::seconds(1);
+        while (!exited) {
+            for (int tid : tids) {
+                uint32_t f = last_func_vram[tid].load(std::memory_order_relaxed);
+                if (f == 0) {
+                    continue;
+                }
+                std::lock_guard<std::mutex> lock{profile_mutex};
+                size_t i = 0;
+                for (; i < profile_used; i++) {
+                    if (profile_table[i].tid == (uint32_t)tid && profile_table[i].func == f) {
+                        profile_table[i].count++;
+                        break;
+                    }
+                }
+                if (i == profile_used && profile_used < kProfileSlots) {
+                    profile_table[profile_used++] = {(uint32_t)tid, f, 1};
+                }
+            }
+            // Per-second timeline: the dominant function of every thread in the
+            // last second, in the same trace_millis clock as the display-list
+            // submissions. This is what distinguishes "the game is computing"
+            // from "the game is waiting on a queue" during a slow frame.
+            if (std::chrono::steady_clock::now() >= next_report) {
+                next_report += std::chrono::seconds(1);
+                std::lock_guard<std::mutex> lock{profile_mutex};
+                printf("[prof] T=%-6llu", (unsigned long long)ultramodern::trace_millis());
+                for (int tid : tids) {
+                    uint32_t best_func = 0;
+                    uint64_t best_count = 0, tid_total = 0;
+                    for (size_t i = 0; i < profile_used; i++) {
+                        if (profile_table[i].tid != (uint32_t)tid) {
+                            continue;
+                        }
+                        tid_total += profile_table[i].count;
+                        if (profile_table[i].count > best_count) {
+                            best_count = profile_table[i].count;
+                            best_func = profile_table[i].func;
+                        }
+                    }
+                    if (tid_total > 0) {
+                        printf(" t%d:%08X(%llu%%)", tid, best_func,
+                               (unsigned long long)(100 * best_count / tid_total));
+                    }
+                }
+                printf("\n");
+                fflush(stdout);
+                // Entry-count deltas: which threads actually executed game code
+                // in the last second (a blocked thread's count is frozen even
+                // though last_func_vram still names its last call site).
+                printf("[prof]   entries/s:");
+                for (int tid : tids) {
+                    uint64_t n = ultramodern::debug_entry_count(tid);
+                    printf(" t%d:%llu", tid, (unsigned long long)(n - profile_last_entry_counts[tid]));
+                    profile_last_entry_counts[tid] = n;
+                }
+                printf("\n");
+                // Hot-loop bounds: the work these functions do is proportional
+                // to game-side counts, and a garbage count turns a scan into a
+                // multi-hundred-ms stall. Print the ones the profiled threads
+                // sit in so a stall is explained by its bound, not by a guess.
+                if (uint8_t* rdram = ultramodern::get_rdram_base()) {
+                    auto rw = [&](uint32_t addr) -> uint32_t {
+                        return *(uint32_t*)(rdram + ((int64_t)(int32_t)addr - (int64_t)0xFFFFFFFF80000000ll));
+                    };
+                    auto rb = [&](uint32_t addr) -> uint32_t {
+                        return *(uint8_t*)(rdram + ((((int64_t)(int32_t)addr) ^ 3) - (int64_t)0xFFFFFFFF80000000ll));
+                    };
+                    printf("[prof]   bounds: D_800B1804=%u D_800B1860=0x%08X D_800B1864=0x%08X D_800B1878=%u\n",
+                           rw(0x800B1804u), rw(0x800B1860u), rw(0x800B1864u), rw(0x800B1878u));
+                    printf("[prof]   frame: retrace(D_800C4BCC)=%u last(D_800AEFA4)=%u acc(D_800A81FE)=%u/%u "
+                           "req(D_800E810C)=%u pend(D_800E7A0C)=%u ready(D_800C4CE4)=%u\n",
+                           rw(0x800C4BCCu), rw(0x800AEFA4u), rb(0x800A81FEu), rb(0x800A81FFu),
+                           rb(0x800E810Cu), rw(0x800E7A0Cu) & 0xFF, rb(0x800C4CE4u));
+                    if (getenv("OGRE_PROFILE_CHAINS") != nullptr) {
+                        for (int tid : {3, 4, 5, 17}) {
+                            ultramodern::debug_dump_call_chain(tid, "prof");
+                        }
+                    }
+                    fflush(stdout);
+                }
+                profile_used = 0;
+                // Hot functions by entry count in the last second. This says
+                // which recompiled function the game actually spent its time
+                // in, independent of whether it was runnable or blocked.
+                for (int n = 0; n < 8; n++) {
+                    size_t best = 0;
+                    bool found = false;
+                    for (size_t i = 0; i < kFuncCountSlots; i++) {
+                        if (func_count_val[i] > (found ? func_count_val[best] : 0)) {
+                            best = i;
+                            found = true;
+                        }
+                    }
+                    if (!found || func_count_val[best] == 0) {
+                        break;
+                    }
+                    if (n == 0) {
+                        printf("[prof]   hot:");
+                    }
+                    printf(" %08X x%llu", func_count_key[best], (unsigned long long)func_count_val[best]);
+                    func_count_val[best] = 0;
+                }
+                printf("\n");
+                fflush(stdout);
+            }
+            std::this_thread::sleep_for(std::chrono::microseconds(250));
+        }
+    });
+    profile_thread.detach();
+}
+
+void ultramodern::debug_profile_dump(void) {
+    if (!profile_on.load()) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock{profile_mutex};
+    uint64_t total = 0;
+    for (size_t i = 0; i < profile_used; i++) {
+        total += profile_table[i].count;
+    }
+    // Selection sort of the top entries (small table, dump once).
+    constexpr size_t kTop = 30;
+    printf("[profile] %zu (tid,function) pairs, %llu samples:\n",
+           profile_used, (unsigned long long)total);
+    for (size_t n = 0; n < kTop && n < profile_used; n++) {
+        size_t best = n;
+        for (size_t i = n + 1; i < profile_used; i++) {
+            if (profile_table[i].count > profile_table[best].count) {
+                best = i;
+            }
+        }
+        std::swap(profile_table[n], profile_table[best]);
+        const ProfileEntry& e = profile_table[n];
+        printf("[profile] %6.2f%%  t%-3u 0x%08X  %llu samples\n",
+               100.0 * (double)e.count / (double)(total ? total : 1),
+               e.tid, e.func, (unsigned long long)e.count);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// OGRE_COVER=1 recompiled-function coverage census.
+//
+// `func_count_key[]` is allocated on the first entry of each function and never
+// cleared, so at exit its occupied slots ARE the set of recompiled functions the
+// run executed -- a coverage census, as opposed to the profiler's per-second
+// top-8. `debug_profile_start()` also feeds this table, but it starts the
+// sampling thread too; `debug_cover_start()` only turns the counters on, so a
+// coverage run pays for the entry hooks and nothing else.
+//
+// The dump is a flat list (one address per line, plus the entry count) rather
+// than a summary because the comparison that matters is against the port's
+// registered entry set, which lives in the build artifacts
+// (app/src/bank_funcs.inc + RecompiledFuncs/recomp_overlays.inl);
+// tools/recompcov.py does that join and reports the per-unit breakdown.
+// ---------------------------------------------------------------------------
+
+void ultramodern::debug_cover_start(void) {
+    if (cover_output() == nullptr) {
+        return;
+    }
+    profile_on.store(true, std::memory_order_relaxed);
+}
+
+void ultramodern::debug_cover_dump(void) {
+    const char* path = cover_output();
+    if (path == nullptr) {
+        return;
+    }
+    // The first dump of the process truncates, later ones append, so a mid-run
+    // `cover` snapshot and the exit dump both survive in the same file.
+    static bool first = true;
+    FILE* out = stdout;
+    if (path[0] != '\0') {
+        out = fopen(path, first ? "w" : "a");
+        if (out == nullptr) {
+            fprintf(stderr, "[cover] cannot open %s\n", path);
+            return;
+        }
+    }
+    first = false;
+    size_t used = 0;
+    for (size_t i = 0; i < kFuncCountSlots; i++) {
+        if (func_count_key[i] != 0) {
+            used++;
+        }
+    }
+    fprintf(out, "[cover] %zu distinct recompiled function(s) entered (%zu/%zu table "
+            "slots)\n", used, used, kFuncCountSlots);
+    for (size_t i = 0; i < kFuncCountSlots; i++) {
+        if (func_count_key[i] != 0) {
+            fprintf(out, "[cover] 0x%08X %llu\n", func_count_key[i],
+                    (unsigned long long)func_count_val[i]);
+        }
+    }
+    if (out == stdout) {
+        fflush(stdout);
+    } else {
+        fclose(out);
+        printf("[cover] wrote %zu function address(es) to %s\n", used, path);
+        fflush(stdout);
+    }
+}
