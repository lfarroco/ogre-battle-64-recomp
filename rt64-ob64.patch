+                         G_TX_NOMASK, G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
+
+            // imageW/imageH are u10.5 (one texel is 32 units) and the RDP's tile
+            // size is in 1/4 texel units with an inclusive `lrs`/`lrt`, so a
+            // 16-texel macroblock is `16*4 - 4 = 60`.
+            const int32_t tileLrs = (int32_t(sprite.imageW) >> 3) - 4;
+            const int32_t tileLrt = (int32_t(sprite.imageH) >> 3) - 4;
+            rdp->setTileSize(G_TX_RENDERTILE, 0, 0, uint16_t(std::max(tileLrs, 0)), uint16_t(std::max(tileLrt, 0)));
+
+            // RT64's drawTexRect takes its gradients such that 1024 is exactly one
+            // texel per pixel (see drawRect's texcoord math), and the rectangle's
+            // coordinates are the RDP's 10.2 (1/4 pixel).
+            const float rectW = x1 - x0;
+            const float rectH = y1 - y0;
+            const int16_t dsdx = (rectW > 0.0f) ? int16_t(1024.0f * imageW / rectW) : int16_t(1024);
+            const int16_t dtdy = (rectH > 0.0f) ? int16_t(1024.0f * imageH / rectH) : int16_t(1024);
+            const bool flipS = (sprite.imageFlags & S2DEX_G_BG_FLAG_FLIPS) != 0;
+            const bool flipT = (sprite.imageFlags & S2DEX_G_BG_FLAG_FLIPT) != 0;
+            rdp->drawTexRect(int32_t(x0 * 4.0f), int32_t(y0 * 4.0f), int32_t(x1 * 4.0f), int32_t(y1 * 4.0f),
+                             G_TX_RENDERTILE, 0, 0, dsdx, dtdy, flipS != flipT);
+        }
