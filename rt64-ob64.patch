+                mtx.b = 0;
+                mtx.c = 0;
+                mtx.d = 0x10000;
+                mtx.x = int16_t(w0 >> 16);
+                mtx.y = int16_t(w0);
+                mtx.baseScaleX = uint16_t(w1 >> 16);
+                mtx.baseScaleY = uint16_t(w1);
+                mtx.subMtx = true;
+            }
+        }
