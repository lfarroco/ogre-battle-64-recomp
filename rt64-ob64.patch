+        // OGRE: the S2DEX 2D object commands (G_OBJ_MOVEMEM / G_OBJ_RECTANGLE*).
+        //
+        // Ogre Battle 64's njpeg backgrounds are drawn entirely with these: the
+        // game's display list loads one 16x16 decoded macroblock into TMEM per
+        // object and then issues `gSPObjSubMatrix` + `gSPObjRectangleR` for it
+        // (see docs/HANDOFF-2026-09-15-session51.md). Before this, the S2DEX2 GBI
+        // mapped neither command, so every macroblock was loaded and never drawn
+        // and the framebuffer the game reads back stayed empty.
+        //
+        // The structs are big-endian guest data, and RT64's RDRAM holds host-order
+        // 32-bit words (the two 16-bit halves of every word are therefore
+        // swapped), so the fields are split out of explicitly-read words instead
+        // of being cast from a struct.
+        uint32_t guestWord(const uint8_t *p) {
+            return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+        }
+
+        struct ObjSprite {
+            int32_t objX, objY;            // s10.2
+            uint16_t scaleW, scaleH;       // u5.10
+            uint16_t imageW, imageH;       // u10.5
+            uint16_t imageStride;          // texture line, in 64-bit words
+            uint16_t imageAdrs;            // TMEM address, in 64-bit words
+            uint8_t imageFmt, imageSiz, imagePal, imageFlags;
+        };
+
+        ObjSprite decodeObjSprite(const uint8_t *p) {
+            const uint32_t w0 = guestWord(p + 0);
+            const uint32_t w1 = guestWord(p + 4);
+            const uint32_t w2 = guestWord(p + 8);
+            const uint32_t w3 = guestWord(p + 12);
+            const uint32_t w4 = guestWord(p + 16);
+            const uint32_t w5 = guestWord(p + 20);
+            ObjSprite sprite;
+            sprite.objX = int16_t(w0 >> 16);
+            sprite.scaleW = uint16_t(w0);
+            sprite.imageW = uint16_t(w1 >> 16);
+            sprite.objY = int16_t(w2 >> 16);
+            sprite.scaleH = uint16_t(w2);
+            sprite.imageH = uint16_t(w3 >> 16);
+            sprite.imageStride = uint16_t(w4 >> 16);
+            sprite.imageAdrs = uint16_t(w4);
+            sprite.imageFmt = uint8_t(w5 >> 24);
+            sprite.imageSiz = uint8_t(w5 >> 16);
+            sprite.imagePal = uint8_t(w5 >> 8);
+            sprite.imageFlags = uint8_t(w5);
+            return sprite;
+        }
+
+        // Draws one object sprite/rectangle as an RDP texture rectangle. The
+        // texture is already in TMEM (the game loads it with SETTIMG/SETTILE/
+        // LOADTILE right before the object command), so the render tile is set up
+        // from the sprite's own image description.
+        //
+        // `fullMatrix` selects the object matrix (G_OBJ_SPRITE / G_OBJ_LDTX_SPRITE
+        // / G_OBJ_RECTANGLE / G_OBJ_LDTX_RECT); the `...R` commands use only the
+        // object matrix's origin and base scale (the `uObjSubMtx` fields).
+        //
+        // TODO: the object matrix's rotation terms are read but not applied, and
+        // an RDP rectangle cannot express a rotated sprite. The `...R` commands
+        // Ogre Battle 64 uses cannot rotate, so this is exact for it; a rotated
+        // `gSPObjSprite` will be drawn axis-aligned.
+        void drawObjRectangle(State *state, const uint8_t *spriteData, bool fullMatrix) {
+            RDP *rdp = state->rdp.get();
+            const ObjSprite sprite = decodeObjSprite(spriteData);
+            const auto &mtx = state->rsp->S2D.objMtx;
+
+            const float imageW = sprite.imageW / 32.0f;
+            const float imageH = sprite.imageH / 32.0f;
+            const float scaleW = float(std::max<uint16_t>(sprite.scaleW, 1)) / 1024.0f;
+            const float scaleH = float(std::max<uint16_t>(sprite.scaleH, 1)) / 1024.0f;
+            const float objX = sprite.objX / 4.0f;
+            const float objY = sprite.objY / 4.0f;
+            const float objW = imageW / scaleW + objX;
+            const float objH = imageH / scaleH + objY;
+
+            const float mtxX = mtx.x / 4.0f;
+            const float mtxY = mtx.y / 4.0f;
+            const float baseScaleX = float(std::max(mtx.baseScaleX, 1)) / 1024.0f;
+            const float baseScaleY = float(std::max(mtx.baseScaleY, 1)) / 1024.0f;
+
+            float x0, y0, x1, y1;
+            if (fullMatrix && !mtx.subMtx) {
+                const float a = mtx.a / 65536.0f;
+                const float b = mtx.b / 65536.0f;
+                const float c = mtx.c / 65536.0f;
+                const float d = mtx.d / 65536.0f;
+                x0 = a * objX + b * objY + mtxX;
+                y0 = c * objX + d * objY + mtxY;
+                x1 = a * objW + b * objH + mtxX;
+                y1 = c * objW + d * objH + mtxY;
+            }
+            else {
+                x0 = mtxX + objX / baseScaleX;
+                y0 = mtxY + objY / baseScaleY;
+                x1 = mtxX + objW / baseScaleX;
+                y1 = mtxY + objH / baseScaleY;
