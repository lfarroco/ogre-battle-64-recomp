+            // OGRE_S2D_TRACE=1: the first 40 object commands, with the sprite's
+            // texture description, the matrix-derived destination and the target
+            // colour image. This is the diagnostic that showed Ogre Battle 64's
+            // 300 macroblock rectangles tiling its 320x240 njpeg framebuffer.
+            if (getenv("OGRE_S2D_TRACE") != nullptr) {
+                static uint32_t s2dTrace = 0;
+                if (++s2dTrace <= 40) {
+                    fprintf(stderr,
+                            "[s2d] %s fmt=%u siz=%u img=%dx%d stride=%u adrs=%u mtx=(%.2f,%.2f,%.4f,%.4f) "
+                            "rect=(%.1f,%.1f)-(%.1f,%.1f) cimg=0x%08X texaddr=0x%08X\n",
+                            fullMatrix ? "obj" : "rectR", (unsigned)sprite.imageFmt, (unsigned)sprite.imageSiz,
+                            (int)imageW, (int)imageH, (unsigned)sprite.imageStride, (unsigned)sprite.imageAdrs,
+                            mtxX, mtxY, baseScaleX, baseScaleY, x0, y0, x1, y1,
+                            (unsigned)rdp->colorImage.address, (unsigned)rdp->texture.address);
+                    fflush(stderr);
+                }
+            }
