+                mtx.a = int32_t(guestWord(p + 0));
+                mtx.b = int32_t(guestWord(p + 4));
+                mtx.c = int32_t(guestWord(p + 8));
+                mtx.d = int32_t(guestWord(p + 12));
+                const uint32_t w4 = guestWord(p + 16);
+                const uint32_t w5 = guestWord(p + 20);
+                mtx.x = int16_t(w4 >> 16);
+                mtx.y = int16_t(w4);
+                mtx.baseScaleX = uint16_t(w5 >> 16);
+                mtx.baseScaleY = uint16_t(w5);
+                mtx.subMtx = false;
